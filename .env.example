# Server (copy to server/.env)
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sweety
JWT_SECRET=change-me-to-a-long-random-string

# Optional: enables the AI "weekly check-in" on the home screen.
# Leave empty to turn the feature off (the rest of the app works without it).
ANTHROPIC_API_KEY=

# Optional: serve the built client (client/dist) from the API. Used by Docker.
SERVE_CLIENT=false

# Client (Vite dev server proxy target)
VITE_API_URL=http://localhost:4000
